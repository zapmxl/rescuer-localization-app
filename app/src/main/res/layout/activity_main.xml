<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    tools:context=".MainActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="0dp" />

    <Button
        android:id="@+id/infoButton"
        android:layout_width="77dp"
        android:layout_height="44dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="1dp"
        android:backgroundTint="#83009688"
        android:checked="true"
        android:text="Info"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Switch
        android:id="@+id/switch1"
        android:layout_width="100dp"
        android:layout_height="20dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="50dp"
        android:checked="true"
        android:text="Visual"
        android:thumbTint="#A8FF0000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Switch
        android:id="@+id/switch2"
        android:layout_width="100dp"
        android:layout_height="20dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="70dp"
        android:checked="true"
        android:text="Inertial"
        android:thumbTint="#A84CAF50"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Switch
        android:id="@+id/switch3"
        android:layout_width="100dp"
        android:layout_height="20dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="90dp"
        android:checked="true"
        android:text="Galileo"
        android:thumbTint="#A82196F3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Switch
        android:id="@+id/switch4"
        android:layout_width="100dp"
        android:layout_height="20dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="110dp"
        android:checked="true"
        android:text="Fusion"
        android:thumbTint="#A8FFEB3B"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/focusLastMarkerButton"
        android:layout_width="169dp"
        android:layout_height="40dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="660dp"
        android:backgroundTint="#A82196F3"
        android:text="Focus on last topic"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:layout_editor_absoluteY="17dp" />

    <Button
        android:id="@+id/clearButton"
        android:layout_width="85dp"
        android:layout_height="40dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="620dp"
        android:backgroundTint="#39F3DE21"
        android:text="Clear"
        android:textAlignment="center"
        android:textColor="#FF0000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/connectionIndicator"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/baseline_wifi_black"
        app:tint="#FF0000"
        android:layout_marginLeft="60dp"
        android:layout_marginBottom="170dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <Button
        android:id="@+id/mapTypeButton"
        android:layout_width="70dp"
        android:layout_height="50dp"
        android:layout_gravity="start|top"
        android:backgroundTint="#A803A9F4"
        android:drawableLeft="@android:drawable/ic_dialog_map"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="17dp" />

    <Button
        android:id="@+id/remoteButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="35dp"
        android:layout_marginBottom="110dp"
        android:backgroundTint="#A84CAF50"
        android:onClick="showRemoteDialog"
        android:text="Remote"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/button"
        android:layout_width="150dp"
        android:layout_height="60dp"
        android:layout_marginLeft="10dp"
        android:layout_marginBottom="50dp"
        android:backgroundTint="#A8FF0000"
        android:text="Add Broker IP and SourceID"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
